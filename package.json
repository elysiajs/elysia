	"scripts": {
		"test": "bun run test:functionality && bun run test:types && bun run test:bundle && bun run test:type-perf",
		"test:functionality": "bun run build && bun test ./test && bun run test:imports",
		"test:imports": "bun run test/type-system/import.ts",
		"test:types": "tsc --project tsconfig.test.json",
		"test:node": "bun run build && npm install --prefix test/node/cjs && npm install --prefix test/node/esm/ && node test/node/cjs/index.js && node test/node/esm/index.js",
		"test:bundle": "bun run test/bundle-size.ts",
		"test:type-perf": "bun run test/type-perf.ts",
		"lint": "eslint src",
		"test:cf": "bun run build && npm install --prefix test/cloudflare && cd test/cloudflare && bun run cf-typegen && bun run test",
		"bench": "bun run example/stress/run.ts",
		"bench:quick": "bun run example/stress/run.ts --quick",
		"bench:throughput": "bun run example/stress/throughput.ts",
		"bench:d1": "bun run bench/d1/run.ts",
		"dev": "bun run --watch example/a.ts",
		"build": "bun build.ts",
		"release": "bun run test && bun publish"
	},
	"sideEffects": [
		"./dist/type/exports.mjs",
		"./dist/type/exports.js",
		"./dist/type/bridge-live.mjs",
		"./dist/type/bridge-live.js",
